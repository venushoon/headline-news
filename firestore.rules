rules_version = '2';

// 어린이 헤드라인 뉴스 — 신문은 누구나 읽고, 쓰기는 발행 서버(Admin SDK)만.
// Admin SDK는 보안 규칙을 거치지 않으므로 main.py의 발행은 영향받지 않는다.
//
// ⚠️ 적용 방법: 이 저장소에는 기본 데이터베이스가 아닌 네임드 데이터베이스
// 'headline-news-d6a13'을 쓰므로, firebase CLI의 기본 배포 대상과 다를 수 있다.
// Firebase 콘솔 → Firestore Database → (headline-news-d6a13 선택) → 규칙 탭에
// 이 내용을 붙여 넣고 게시하는 것이 가장 확실하다.
service cloud.firestore {
  match /databases/{database}/documents {
    // 신문 본문: 누구나 읽기 가능, 클라이언트 쓰기 금지
    match /daily_briefings/{date} {
      allow get, list: if true;
      allow write: if false;
    }
    // 그 외 모든 컬렉션은 전면 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
