# 이 파일을 복사해 .env로 만들고 값을 채우세요. (.env는 절대 커밋하지 마세요)
# GitHub Actions 배포에서는 같은 이름들을 저장소 Secrets에 등록합니다.

# --- 프론트엔드 (Vite 빌드용) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=headline-news-d6a13
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- 백엔드 (main.py 로컬 실행용) ---
GEMINI_API_KEY=
# serviceAccountKey.json 파일을 저장소 루트에 두세요 (절대 커밋 금지).
# 이미 발행된 오늘 신문을 강제로 다시 만들 때만 아래를 켭니다.
# FORCE_RUN=1
